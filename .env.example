# AutoLead AI Environment Configuration Template
# Instructions:
# 1. Copy this file to .env (and backend/.env)
# 2. Fill in your credentials below

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.erzzeaq.mongodb.net/autolead?retryWrites=true&w=majority&appName=Cluster0
MONGODB_DB_NAME=autolead
DATABASE_TYPE=mongodb

# Google Gemini AI API Key (for pitch generation and website auditing)
GEMINI_API_KEY=your_gemini_api_key_here

# Gmail SMTP Configuration for Autonomous Pitch Delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_google_app_password
FROM_NAME="NexBharat"
